{
  "name": "@sds/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "SuperDuperSource desktop app",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.config.cjs --publish never"
  },
  "devDependencies": {
    "@sds/atem": "^0.1.0",
    "@sds/core": "*",
    "@sds/protocol": "^0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "atem-connection": "^3.10.3",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.0"
  },
  "productName": "SuperDuperSource",
  "author": {
    "name": "Andrew (kennedys.nz)"
  },
  "homepage": "https://superdupersource.kennedys.nz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ARKplayzz/superdupersource.git"
  }
}
